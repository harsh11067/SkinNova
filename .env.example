# SkinNova environment — copy to .env (gitignored) and fill. NEVER commit .env.
# Loaded by ml/common/paths.py (python-dotenv) and by Gradle signing config (release only).

# ── Hugging Face ────────────────────────────────────────────────
HF_TOKEN=                       # huggingface.co → Settings → Access Tokens → type WRITE
HF_USER=                        # your HF username or org
HF_SFT_DATASET_REPO=${HF_USER}/skinnova-sft-data        # private dataset
HF_LORA_REPO=${HF_USER}/skinnova-e2b-lora-v1            # private model (adapter)
HF_MERGED_REPO=${HF_USER}/skinnova-e2b-merged           # private model (16-bit merged)
HF_BASE_MODEL=unsloth/gemma-4-E2B-it                    # training base
HF_STOCK_LITERTLM_REPO=litert-community/gemma-4-E2B-it-litert-lm
HF_HOME=/home/<you>/.cache/huggingface                  # keep caches on WSL native FS

# ── Kaggle ──────────────────────────────────────────────────────
# Kaggle CLI ≥ 1.8: use KAGGLE_API_TOKEN (Settings → API → Generate New Token)
KAGGLE_API_TOKEN=
# Legacy alternative (older CLI / kaggle.json): fill these instead
KAGGLE_USERNAME=
KAGGLE_KEY=
KAGGLE_DATASET_SLUG=${KAGGLE_USERNAME}/skinnova-data     # private dataset you upload
# In Kaggle notebooks add HF_TOKEN via Add-ons → Secrets (not via this file)

# ── Local paths (WSL) ───────────────────────────────────────────
SKINNOVA_REPO=/mnt/c/dev/skinnova
SKINNOVA_DATA_DIR=/home/<you>/skinnova-data/data
SKINNOVA_MODELS_DIR=/home/<you>/skinnova-data/models
LITERTLM_OUT_NAME=skinnova-e2b-v1.litertlm
CV_TFLITE_NAME=skin_cls.tflite

# ── Android / adb ───────────────────────────────────────────────
ADB=adb.exe                                   # Windows adb via WSL interop (one adb server only)
ANDROID_PROJECT_WIN=C:\dev\skinnova\android   # for: cmd.exe /c "cd /d %ANDROID_PROJECT_WIN% && gradlew.bat ..."
APP_ID=com.skinnova.app
DEVICE_MODEL_DIR=/sdcard/Android/data/com.skinnova.app/files/models
DEVICE_SERIAL=                                # from `adb devices`, when >1 device connected

# ── Release signing (used only by assembleOfflineRelease) ───────
SKINNOVA_KEYSTORE_PATH=C:\keys\skinnova-release.jks
SKINNOVA_KEYSTORE_PASSWORD=
SKINNOVA_KEY_ALIAS=skinnova
SKINNOVA_KEY_PASSWORD=

# ── Evaluation only (never shipped in the app) ──────────────────
JUDGE_PROVIDER=                               # gemini | anthropic | none
GEMINI_API_KEY=                               # used by ai-edge-eval / judge.py if JUDGE_PROVIDER=gemini
ANTHROPIC_API_KEY=                            # if JUDGE_PROVIDER=anthropic
WANDB_API_KEY=                                # optional training logs; leave empty to disable

# ── Reproducibility ─────────────────────────────────────────────
SEED=3407
PROMPT_VERSION=v1
LABELS_VERSION=v1
