    <string name="rf_r1">बुखार या तबीयत खराब होने के साथ दर्द वाला या फैलता दाने का मतलब संक्रमण हो सकता है। आज ही इलाज लें।</string>
    <string name="rf_r2">जो दाग बढ़ रहा है या जिसका रंग या आकार बदल रहा है, उसे डॉक्टर को दिखाना चाहिए।</string>
    <string name="rf_r3">एक हफ़्ते से ज़्यादा समय तक खून आना या पपड़ी बनना डॉक्टर को दिखाना चाहिए।</string>
    <string name="rf_r4">इमेज मॉडल को ऐसे लक्षण दिखे हैं जिन्हें डॉक्टर खुद देखना पसंद करते हैं।</string>
    <string name="rf_r5">12 साल से कम उम्र के बच्चों की त्वचा की समस्या डॉक्टर को दिखानी चाहिए।</string>
    <string name="rf_r6">चेहरे या जांघ के जोड़ पर दर्द वाले दाने डॉक्टर को दिखाने चाहिए।</string>
    <string name="rf_r7">घर में दूसरों को भी है। यह छूने से फैल सकता है; सभी प्रभावित लोगों की जाँच साथ में होनी चाहिए।</string>
    <string name="rf_r8">फ़ोटो की क्वालिटी खराब थी, इसलिए यह नतीजा बहुत अनिश्चित है।</string>
